{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scoring_checklist.schema.json",
  "title": "Two-Dimension Image VQA Scoring Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "evaluation_mode",
    "dimension_weights",
    "grounded_requirement_satisfaction",
    "visual_rendering_quality"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_[0-9]{3}$"
    },
    "evaluation_mode": {
      "const": "image_vqa_0_2"
    },
    "dimension_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounded_requirement_satisfaction",
        "visual_rendering_quality"
      ],
      "properties": {
        "grounded_requirement_satisfaction": {"const": 0.8},
        "visual_rendering_quality": {"const": 0.2}
      }
    },
    "grounded_requirement_satisfaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vqa_items"],
      "properties": {
        "vqa_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/grounded_item"}
        }
      }
    },
    "visual_rendering_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_type", "vqa_items"],
      "properties": {
        "image_type": {
          "type": "string",
          "enum": [
            "executive_dashboard",
            "data_story_infographic",
            "promotional_poster",
            "public_information_poster",
            "customer_display_card",
            "exhibit_panel",
            "public_information_board",
            "paid_social_ad",
            "social_infographic",
            "wayfinding_graphic",
            "out_of_home_ad",
            "digital_banner_ad",
            "public_service_graphic",
            "research_infographic",
            "reference_infographic",
            "social_campaign_creative",
            "instructional_guide",
            "er_diagram",
            "data_flow_diagram",
            "escalation_hierarchy_chart",
            "process_flow",
            "relationship_network",
            "release_announcement"
          ]
        },
        "vqa_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/visual_item"}
        }
      }
    }
  },
  "$defs": {
    "grounded_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "score_criteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^grounded_q[0-9]+$"},
        "state": {"type": "string", "minLength": 5, "pattern": "\\?"},
        "score_criteria": {"$ref": "#/$defs/score_criteria"}
      }
    },
    "visual_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "score_criteria"],
      "properties": {
        "id": {"const": "visual_q01"},
        "state": {"type": "string", "minLength": 20, "pattern": "\\?"},
        "score_criteria": {"$ref": "#/$defs/score_criteria"}
      }
    },
    "score_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["2", "1", "0"],
      "properties": {
        "2": {"type": "string", "minLength": 20, "pattern": "^Score 2\\b"},
        "1": {"type": "string", "minLength": 20, "pattern": "^Score 1\\b"},
        "0": {"type": "string", "minLength": 20, "pattern": "^Score 0\\b"}
      }
    }
  }
}
